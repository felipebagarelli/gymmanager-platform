# Copie para .env.prod (fora do git) e preencha. NUNCA commite o arquivo preenchido.

# dominios (DNS apontando para o IP da VPS)
APP_DOMAIN=app.seudominio.com
API_DOMAIN=api.seudominio.com

# banco
DB_USERNAME=gymmanager
DB_PASSWORD=troque-por-uma-senha-forte

# assinatura dos tokens: minimo 32 caracteres aleatorios (ex.: openssl rand -base64 48)
JWT_SECRET=

# assistente de IA (opcional: sem chave o assistente responde "indisponivel")
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_DAILY_LIMIT=30

# pagamentos Stripe (opcional: sem chave a cobranca responde "indisponivel")
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=10
