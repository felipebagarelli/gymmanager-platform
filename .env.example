# Copie para .env.prod (fora do git) e preencha. NUNCA commite o arquivo preenchido.

# dominios (DNS apontando para o IP da VPS)
APP_DOMAIN=app.seudominio.com
API_DOMAIN=api.seudominio.com

# banco
DB_USERNAME=gymmanager
DB_PASSWORD=troque-por-uma-senha-forte

# assinatura dos tokens: minimo 32 caracteres aleatorios (ex.: openssl rand -base64 48)
JWT_SECRET=

# assistente de IA (opcional: sem chave o assistente responde "indisponivel")
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_DAILY_LIMIT=30

# pagamentos Stripe (opcional: sem chave a cobranca responde "indisponivel")
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=10

# e-mail (OBRIGATORIO em producao: sem MAIL_HOST o backend nao sobe). Brevo, Resend ou Amazon SES por SMTP.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=GymManager <nao-responda@seudominio.com>
# contato mostrado na pagina /conta/excluir (exigencia do Google Play)
SUPPORT_EMAIL=suporte@seudominio.com

# termos de uso e politica de privacidade publicados (o app abre estes links)
TERMS_VERSION=2026-10-16-rascunho
TERMS_URL=
PRIVACY_URL=

# plano da plataforma (GymManager Pro): vendas fechadas ate PLATFORM_PLAN_ENABLED=true
STRIPE_PLATFORM_WEBHOOK_SECRET=
PLATFORM_PLAN_ENABLED=false
PLATFORM_PLAN_MONTHLY_CENTS=1990
PLATFORM_PLAN_YEARLY_CENTS=14990
PLATFORM_PLAN_TRIAL_DAYS=7

# IA que monta treinos: propostas por mes
AI_PROPOSALS_FREE_PER_MONTH=1
AI_PROPOSALS_PRO_PER_MONTH=30
